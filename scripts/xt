#!/usr/bin/env bash
# The pinned xetal with every library on the search path: each
# libs/<Name>/src on XETAL_PATH, then X_eTaL-libraries' at the pin
# (scripts/libpath.sh), written relative to the current directory so
# messages and baselines do not depend on where the repository is
# checked out. "xt run FILE" adds --seed 1 --ascii and --draw work/draw
# (as the tests run); any other command passes through.
# Adapted from X_eTaL-manifolds' scripts/xt (no X_eTaL-ML).
#   scripts/xt run prog.xtl
#   scripts/xt type ../src/Balance.xtl
#   scripts/xt eval -e "'+ r_/ 1 2 3"
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
xetal="$root/work/xetal/target/release/xetal"
[ -x "$xetal" ] || xetal="$("$root/scripts/xetal.sh")"
[ -d "$root/work/xetal-libraries/.git" ] || "$root/scripts/xetal-libraries.sh"
XETAL_PATH="$("$root/scripts/py" - "$root" <<'PY'
import os, sys
from pathlib import Path
root = Path(sys.argv[1])
dirs = []
for pattern in ("libs/*/src", "work/xetal-fbp/libs/*/src", "work/xetal-libraries/libs/*/src"):
    dirs += sorted(str(d) for d in root.glob(pattern) if d.is_dir())
print(":".join(os.path.relpath(d) for d in dirs))
PY
)"
export XETAL_PATH
draw="$("$root/scripts/py" -c 'import os,sys; print(os.path.relpath(sys.argv[1]))' "$root/work/draw")"
mkdir -p "$root/work/draw"
if [ "${1:-}" = run ]; then shift; exec "$xetal" run --seed 1 --ascii --draw "$draw" "$@"; fi
exec "$xetal" "$@"
